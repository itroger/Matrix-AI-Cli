{
  "name": "matrix-ai-cli",
  "version": "0.1.0",
  "description": "连接本地 Agent 的终端 CLI（TypeScript + ink）",
  "type": "module",
  "bin": {
    "matrix-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "chalk": "^5.3.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
