{
  "name": "matrix-ai-cli",
  "version": "0.1.0",
  "description": "连接本地 Agent 的终端 CLI（TypeScript + ink）",
  "type": "module",
  "bin": {
    "matrix-cli": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "marked": "^18.1.3",
    "marked-terminal": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
